{
  "schema": 2,
  "id": "sakura",
  "name": "Sakura",
  "author": "Dashboard Engine",
  "persona": {
    "name": "Sakura",
    "tagline": "spring, unhurried",
    "lines": [
      "the petals fall in their own time",
      "a gentle day to you",
      "nothing blooms all year — rest a little",
      "the wind carries something sweet"
    ]
  },
  "skin": {
    "palette": {
      "void": "#E9C9D8",
      "glass": "#FFFFFF",
      "accent": "#E77FA8",
      "accentBright": "#5A3A48",
      "muted": "#9E7686",
      "warn": "#D98A8A",
      "gold": "#D79A6E"
    },
    "typography": {
      "display": "system-serif",
      "uppercase": false,
      "letterSpacing": 0.04
    },
    "texture": {
      "scanlines": 0,
      "grid": 0,
      "glow": 0.2,
      "vignette": 0.12
    },
    "shape": {
      "cornerNotches": false,
      "borderOpacity": 0.14,
      "panelOpacity": 0.5,
      "radius": 16
    },
    "ambience": {
      "effect": "petals",
      "density": 0.5
    },
    "wallpaper": "assets/bg.png",
    "background": {
      "layers": [
        { "src": "assets/bg.png", "depth": 0, "fit": "cover", "effects": [
          { "type": "drift-warp", "speed": 0.2, "scale": 3 },
          { "type": "ripple", "speed": 0.4, "scale": 2, "strength": 0.12 }
        ] }
      ],
      "parallax": { "strength": 0.5, "axis": "both" }
    }
  },
  "canvas": {
    "padding": 3
  },
  "components": [
    {
      "type": "status",
      "rect": [
        4,
        6,
        52,
        15
      ],
      "z": 2,
      "options": {},
      "style": {
        "panel": false,
        "align": "left",
        "fontScale": 0.95,
        "glow": 0.1
      }
    },
    {
      "type": "analog-clock",
      "rect": [
        66,
        7,
        30,
        40
      ],
      "z": 2,
      "options": {
        "seconds": true,
        "numerals": "all",
        "minuteTicks": true
      },
      "style": {
        "panel": true,
        "border": false,
        "padding": 16
      }
    },
    {
      "type": "clock",
      "rect": [
        4,
        24,
        44,
        14
      ],
      "z": 2,
      "options": {
        "format": "12h",
        "seconds": false,
        "showDate": true
      },
      "style": {
        "panel": false,
        "align": "left",
        "fontScale": 1.2,
        "glow": 0.15
      }
    },
    {
      "type": "text",
      "rect": [
        4,
        40,
        50,
        16
      ],
      "z": 2,
      "options": {
        "text": "a soft rain of petals —\nthe afternoon drifts by"
      },
      "style": {
        "panel": true,
        "border": false,
        "align": "left",
        "fontScale": 1.05,
        "padding": 18
      }
    },
    {
      "type": "weather",
      "rect": [
        4,
        58,
        50,
        8
      ],
      "z": 2,
      "options": {
        "lat": 0,
        "lon": 0,
        "place": null,
        "compact": true
      },
      "style": {
        "panel": true,
        "border": false,
        "padding": 16
      }
    },
    {
      "type": "agenda",
      "rect": [
        66,
        50,
        30,
        32
      ],
      "z": 2,
      "options": {
        "days": 5,
        "limit": 4,
        "label": "today"
      },
      "style": {
        "panel": true,
        "border": false,
        "padding": 18
      }
    },
    {
      "type": "launcher",
      "rect": [
        4,
        70,
        50,
        18
      ],
      "z": 2,
      "options": {
        "pinned": true,
        "recent": false,
        "running": false,
        "labels": true,
        "iconSize": "m",
        "label": "favourites"
      },
      "style": {
        "panel": false
      }
    },
    {
      "type": "rig",
      "rect": [70, 0, 28, 52],
      "z": 1,
      "options": {
        "layers": [
          { "src": "assets/rig-glow.png", "anchor": { "x": 80, "y": 15 }, "breath": { "scale": 0.03, "speed": 0.12, "phase": 0 }, "sway": { "rotate": 0, "speed": 0.1, "phase": 0 }, "bob": { "y": 0, "speed": 0.1, "phase": 0 }, "gaze": { "x": 0, "y": 0 }, "tiltWithPointer": 0 },
          { "src": "assets/rig-branch.png", "anchor": { "x": 97, "y": 3 }, "breath": { "scale": 0, "speed": 0.1, "phase": 0 }, "sway": { "rotate": 1.2, "speed": 0.1, "phase": 0 }, "bob": { "y": 0, "speed": 0.1, "phase": 0 }, "gaze": { "x": 0, "y": 0 }, "tiltWithPointer": 0 },
          { "src": "assets/rig-blossoms.png", "anchor": { "x": 97, "y": 3 }, "breath": { "scale": 0.02, "speed": 0.18, "phase": 0 }, "sway": { "rotate": 1.4, "speed": 0.1, "phase": 0.06 }, "bob": { "y": 0, "speed": 0.1, "phase": 0 }, "gaze": { "x": 0.6, "y": 0.3 }, "tiltWithPointer": 0.4 },
          { "src": "assets/rig-front.png", "anchor": { "x": 60, "y": 35 }, "breath": { "scale": 0.03, "speed": 0.2, "phase": 0.2 }, "sway": { "rotate": 2.2, "speed": 0.11, "phase": 0.16 }, "bob": { "y": 0.4, "speed": 0.16, "phase": 0.1 }, "gaze": { "x": 1.2, "y": 0.6 }, "tiltWithPointer": 0.8 }
        ]
      },
      "style": {
        "panel": false
      }
    }
  ],
  "props": [
    {
      "key": "accent",
      "label": "Accent colour",
      "type": "color",
      "default": "#E77FA8",
      "bind": {
        "target": "palette",
        "key": "accent"
      }
    },
    {
      "key": "accent-bright",
      "label": "Highlight colour",
      "type": "color",
      "default": "#5A3A48",
      "bind": {
        "target": "palette",
        "key": "accentBright"
      }
    },
    {
      "key": "particles",
      "label": "Particles",
      "type": "select",
      "default": "petals",
      "options": [
        {
          "value": "none",
          "label": "Off"
        },
        {
          "value": "embers",
          "label": "Embers"
        },
        {
          "value": "dust",
          "label": "Dust"
        },
        {
          "value": "snow",
          "label": "Snow"
        },
        {
          "value": "petals",
          "label": "Petals"
        },
        {
          "value": "rain",
          "label": "Rain"
        },
        {
          "value": "sparkle",
          "label": "Sparkle"
        }
      ],
      "bind": {
        "target": "ambience",
        "key": "effect"
      }
    },
    {
      "key": "particle-density",
      "label": "Particle density",
      "type": "slider",
      "min": 0.05,
      "max": 1,
      "step": 0.05,
      "default": 0.5,
      "bind": {
        "target": "ambience",
        "key": "density"
      }
    }
  ]
}
