# Dependencies
node_modules/

# Piper models are large binaries fetched by the first-run downloader — never committed.
# The manifest (voices.json) IS committed.
voices/*
!voices/voices.json

# User-saved profiles are personal data, not source.
profiles/*

# Local tool binaries (piper.exe etc.) fetched per-machine.
bin/

# Build output
dist/

# Smoke-test output
out/

# Atomic-write leftovers (saveProfile, voice downloads)
*.tmp
__pycache__/
store-assets/
# SteamPipe build scripts — hold the machine's absolute contentroot path + build logs
steampipe/

# Kokoro dev engine (model + venv + freeze artifacts are large, never committed)
engine/kokoro/.venv/
engine/kokoro/.build/
voices/kokoro/*.onnx
voices/kokoro/*.bin
